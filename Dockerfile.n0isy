# Keep the released frontend, compiled Rust module and exact dependency set.
# Only the audited Python changes are overlaid on upstream v6.2.6.
FROM glitchtip/glitchtip:6.2.6@sha256:a3d8eb1b36c1e1603d55ab32711ea3dd8115874742a781a57391a62a16e0dff6
ARG REVISION=local
LABEL org.opencontainers.image.source="https://github.com/n0isy/glitchtip" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="MIT"
ENV GLITCHTIP_VERSION=6.2.6+n0isy.1
COPY --chown=app:app apps/alerts/tasks.py /code/apps/alerts/tasks.py
COPY --chown=app:app apps/event_ingest/api.py apps/event_ingest/views.py apps/event_ingest/otlp_views.py apps/event_ingest/quotas.py /code/apps/event_ingest/
COPY --chown=app:app glitchtip/settings.py /code/glitchtip/settings.py
